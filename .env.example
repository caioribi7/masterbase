# Modelo de configuração. O comando `masterbase` lê ~/.config/masterbase/masterbase.env
# (ou o arquivo em MB_CONFIG). `masterbase configurar` escreve esse arquivo para você.
# Variáveis de ambiente com o mesmo nome valem mais que o arquivo.

# Conexão com o Postgres (obrigatória). Caracteres especiais na senha vão em formato de URL (%40 para @).
DATABASE_URL=postgresql://masterbase:troque-esta-senha@127.0.0.1:5432/masterbase

# Endereço em que o painel escuta. Em produção, deixe em 127.0.0.1 e ponha um proxy com HTTPS na frente.
MB_ADDR=127.0.0.1:8080

# Onde os backups são guardados. Precisa de pg_dump e pg_restore instalados.
MB_BACKUP_DIR=backups

# Chave que criptografa os backups. O Masterbase cria e grava sozinho na primeira subida.
# Guarde uma cópia fora do servidor (`masterbase chave-backup`). Sem ela, os backups não abrem.
# MB_BACKUP_KEY=AGE-SECRET-KEY-1...

# Cópia de cada backup para fora do servidor (opcional). Uma pasta em outro disco e/ou um comando.
# MB_BACKUP_COPY_DIR=/mnt/outro-disco/masterbase
# MB_BACKUP_HOOK=rclone copy "$MB_BACKUP_FILE" b2:minha-empresa-backups

# Conexão do editor SQL, com um papel que só lê e muda linhas. Sem ela, o editor fica desligado.
# O instalador cria o papel masterbase_sql e preenche esta linha.
# MB_SQL_URL=postgresql://masterbase_sql:outra-senha@127.0.0.1:5432/masterbase

# Endereço público do painel. Vai nos links dos e-mails e na volta do login com Google/GitHub.
# MB_URL=https://painel.seudominio.com

# Entrar com Google e GitHub (opcional). Passo a passo em docs/login-e-email.md.
# MB_GOOGLE_ID=...apps.googleusercontent.com
# MB_GOOGLE_SECRET=GOCSPX-...
# MB_GITHUB_ID=Ov23li...
# MB_GITHUB_SECRET=...

# E-mail de convite e de senha nova (opcional). Gmail com senha de app serve e é grátis.
# MB_SMTP_HOST=smtp.gmail.com
# MB_SMTP_PORT=465
# MB_SMTP_USER=voce@gmail.com
# MB_SMTP_PASS=senha-de-app-de-16-letras
# MB_MAIL_FROM=Masterbase <voce@gmail.com>

# Pedidos por minuto que cada chave de API pode fazer. Passou disso, responde 429. Padrão 300.
# MB_KEY_RATE=300

# 1 aceita login sem HTTPS. Só para rede local de confiança.
# MB_INSECURE_COOKIE=1

# Serve a tela de uma pasta em vez da que vem dentro do programa. Só para desenvolver.
# MB_WEB_DIR=../web/dist
