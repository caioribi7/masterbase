# Modelo de configuração. O servidor lê variáveis de ambiente; ele não carrega este arquivo sozinho.
# Use com systemd (EnvironmentFile=) ou exporte no terminal antes de rodar.

# Conexão com o Postgres (obrigatória). Caracteres especiais na senha vão em formato de URL (%40 para @).
DATABASE_URL=postgresql://masterbase:troque-esta-senha@127.0.0.1:5432/masterbase

# Endereço em que o servidor escuta. Em produção, deixe em 127.0.0.1 e ponha um proxy com HTTPS na frente.
MB_ADDR=127.0.0.1:8080

# Pasta com a tela compilada (web/dist).
MB_WEB_DIR=../web/dist

# Onde os backups são guardados. Precisa de pg_dump e pg_restore instalados.
MB_BACKUP_DIR=backups
